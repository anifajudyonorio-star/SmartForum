<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.CategoryEnrollmentController"
            prefWidth="800" prefHeight="500">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color:#8e44ad;-fx-padding:12;">
            <Label text="👥  Category Enrollment" style="-fx-text-fill:white;-fx-font-size:20;-fx-font-weight:bold;"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.38">

            <!-- LEFT: Enroll form -->
            <VBox spacing="12" style="-fx-padding:20;">
                <Label text="Enroll Student" style="-fx-font-size:14;-fx-font-weight:bold;"/>

                <Label text="Category"/>
                <ComboBox fx:id="cmbCategory" maxWidth="Infinity" onAction="#loadEnrolled"/>

                <Label text="Student Name"/>
                <TextField fx:id="txtStudentName" promptText="Full name"/>

                <HBox spacing="8">
                    <Button text="Enroll" onAction="#enroll" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color:#8e44ad;-fx-text-fill:white;-fx-padding:8;"/>
                    <Button text="Unenroll" onAction="#unenroll" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                            style="-fx-background-color:#c0392b;-fx-text-fill:white;-fx-padding:8;"/>
                </HBox>

                <Separator/>
                <Label text="Check Student's Category" style="-fx-font-size:13;-fx-font-weight:bold;"/>
                <TextField fx:id="txtCheckName" promptText="Student name to look up"/>
                <Button text="Find Category" onAction="#findCategory" maxWidth="Infinity"
                        style="-fx-background-color:#27ae60;-fx-text-fill:white;-fx-padding:8;"/>
                <Label fx:id="lblFoundCategory" wrapText="true" style="-fx-font-size:13;"/>
            </VBox>

            <!-- RIGHT: Enrolled students list -->
            <VBox spacing="8" style="-fx-padding:16;">
                <Label text="Enrolled Students" style="-fx-font-size:14;-fx-font-weight:bold;"/>
                <ListView fx:id="lstStudents" VBox.vgrow="ALWAYS"/>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>
