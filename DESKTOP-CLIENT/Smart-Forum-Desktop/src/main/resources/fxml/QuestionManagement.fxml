<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.QuestionController"
            prefWidth="1200"
            prefHeight="750">

    <top>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>

            <children>
                <Label text="Question Management">
                    <font>
                        <Font size="26"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="15" left="20" right="20" bottom="15"/>
            </padding>

            <GridPane hgap="10" vgap="10">

                <columnConstraints>
                    <ColumnConstraints prefWidth="170"/>
                    <ColumnConstraints prefWidth="350"/>
                    <ColumnConstraints prefWidth="170"/>
                    <ColumnConstraints prefWidth="350"/>
                </columnConstraints>

                <children>

                    <Label text="Quiz"/>
                    <ComboBox fx:id="cmbQuiz"
                              GridPane.columnIndex="1"/>

                    <Label text="Correct Answer"
                           GridPane.columnIndex="2"/>

                    <ComboBox fx:id="cmbCorrect"
                              GridPane.columnIndex="3"/>

                    <Label text="Question"
                           GridPane.rowIndex="1"/>

                    <TextArea fx:id="txtQuestion"
                              prefRowCount="3"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"
                              GridPane.columnSpan="3"/>

                    <Label text="Option A"
                           GridPane.rowIndex="2"/>

                    <TextField fx:id="txtOptionA"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                    <Label text="Option B"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="2"/>

                    <TextField fx:id="txtOptionB"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="3"/>

                    <Label text="Option C"
                           GridPane.rowIndex="3"/>

                    <TextField fx:id="txtOptionC"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                    <Label text="Option D"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="2"/>

                    <TextField fx:id="txtOptionD"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="3"/>

                </children>

            </GridPane>

            <HBox spacing="10">

                <Button fx:id="btnSave"
                        text="Save"
                        onAction="#saveQuestion"/>

                <Button fx:id="btnUpdate"
                        text="Update"
                        onAction="#updateQuestion"/>

                <Button fx:id="btnDelete"
                        text="Delete"
                        onAction="#deleteQuestion"/>

                <Button fx:id="btnClear"
                        text="Clear"
                        onAction="#clearFields"/>

            </HBox>

            <TableView fx:id="tblQuestions" VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="colQuiz"
                                 text="Quiz"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colQuestion"
                                 text="Question"
                                 prefWidth="350"/>

                    <TableColumn fx:id="colCorrect"
                                 text="Correct"
                                 prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>
