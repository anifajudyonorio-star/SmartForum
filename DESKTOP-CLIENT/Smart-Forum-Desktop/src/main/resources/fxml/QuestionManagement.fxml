<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.QuestionController"
            styleClass="quiz-page" stylesheets="@/com/smartforum/css/app.css">

    <top>
        <VBox styleClass="dashboard-header">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Questions" styleClass="dashboard-title"/>
                    <Label text="Each quiz is listed with its questions underneath."
                           styleClass="dashboard-subtitle"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="16" styleClass="dashboard-content">
                    <padding><Insets top="8" right="24" bottom="24" left="24"/></padding>

                    <!-- ADD / EDIT FORM -->
                    <VBox spacing="12" styleClass="quiz-card">
                        <Label text="Add or edit a question" styleClass="dashboard-card-title"/>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4" prefWidth="260" HBox.hgrow="ALWAYS">
                                <Label text="Quiz" styleClass="form-label"/>
                                <ComboBox fx:id="cmbQuiz" maxWidth="Infinity"
                                          promptText="Select a draft quiz"/>
                            </VBox>
                            <VBox spacing="4" prefWidth="140">
                                <Label text="Correct Answer" styleClass="form-label"/>
                                <ComboBox fx:id="cmbCorrect" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4" prefWidth="110">
                                <Label text="Marks" styleClass="form-label"/>
                                <Spinner fx:id="spQuestionMarks" prefWidth="100"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="4">
                            <Label text="Question" styleClass="form-label"/>
                            <TextArea fx:id="txtQuestion" prefRowCount="3" wrapText="true"
                                      promptText="Enter the question text"
                                      styleClass="form-textarea"/>
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Option A" styleClass="form-label"/>
                                <TextField fx:id="txtOptionA" promptText="Option A"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Option B" styleClass="form-label"/>
                                <TextField fx:id="txtOptionB" promptText="Option B"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Option C" styleClass="form-label"/>
                                <TextField fx:id="txtOptionC" promptText="Option C"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Option D" styleClass="form-label"/>
                                <TextField fx:id="txtOptionD" promptText="Option D"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="8">
                            <Button text="Save Question" onAction="#saveQuestion"
                                    styleClass="btn-primary"/>
                            <Button text="Update" onAction="#updateQuestion"
                                    styleClass="btn-outline"/>
                            <Button text="Delete" onAction="#deleteQuestion"
                                    styleClass="btn-danger"/>
                            <Button text="Clear" onAction="#clearFields"
                                    styleClass="btn-outline"/>
                        </HBox>
                    </VBox>

                    <!-- QUIZ → QUESTIONS OUTLINE -->
                    <Label text="Quizzes &amp; questions" styleClass="dashboard-card-title"/>
                    <Label fx:id="lblOutlineHint" styleClass="dashboard-subtitle"
                           text="Loading quizzes…"/>
                    <VBox fx:id="quizOutlineBox" spacing="14"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
