<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.AnnouncementsController">

    <content>
        <VBox spacing="12.0" styleClass="dashboard-content">
            <HBox alignment="TOP_LEFT" spacing="12.0" styleClass="dashboard-header">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Quiz Announcements" styleClass="dashboard-title"/>
                    <Label fx:id="pageSubtitleLabel"
                           text="Share updates with students enrolled in your quiz titles."
                           styleClass="dashboard-subtitle"/>
                </VBox>
                <Button fx:id="btnAvailableQuizzes" mnemonicParsing="false" onAction="#openAvailableQuizzes"
                        styleClass="btn-outline btn-sm" text="Available Quizzes" visible="false" managed="false"/>
            </HBox>

            <HBox fx:id="enrollmentAlertBox" alignment="CENTER_LEFT" spacing="8.0"
                  styleClass="announcement-alert-info" visible="false" managed="false">
                <Label fx:id="enrollmentAlertLabel" wrapText="true"/>
            </HBox>

            <HBox fx:id="lecturerLayout" spacing="12.0" visible="false" managed="false">
                <VBox minWidth="280.0" prefWidth="320.0" spacing="12.0" styleClass="dashboard-card">
                    <Label text="Post Announcement" styleClass="dashboard-card-title"/>
                    <Label text="Quiz Title" styleClass="form-label"/>
                    <ComboBox fx:id="cmbCategory" maxWidth="1.7976931348623157E308"/>
                    <Label text="Title" styleClass="form-label"/>
                    <TextField fx:id="txtTitle" promptText="Announcement title"/>
                    <Label text="Message" styleClass="form-label"/>
                    <TextArea fx:id="txtMessage" prefRowCount="5" promptText="Write your announcement…"
                              styleClass="form-textarea" wrapText="true"/>
                    <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#postAnnouncement"
                            styleClass="btn-primary" text="Post Announcement"/>
                </VBox>

                <VBox spacing="8.0" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Published Announcements" styleClass="dashboard-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="announcementCountLabel" styleClass="badge-muted" text="0"/>
                    </HBox>
                    <TableView fx:id="tblAnnouncements" styleClass="dashboard-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCategory" prefWidth="120.0" text="Quiz Title"/>
                            <TableColumn fx:id="colTitle" prefWidth="140.0" text="Title"/>
                            <TableColumn fx:id="colMessage" prefWidth="220.0" text="Message"/>
                            <TableColumn fx:id="colBy" prefWidth="110.0" text="Posted By"/>
                            <TableColumn fx:id="colAt" prefWidth="130.0" text="Date"/>
                            <TableColumn fx:id="colAction" prefWidth="90.0" text="Action"/>
                        </columns>
                        <placeholder>
                            <Label styleClass="empty-label" text="No announcements yet."/>
                        </placeholder>
                    </TableView>
                </VBox>
            </HBox>

            <FlowPane fx:id="studentCardsBox" hgap="12.0" maxWidth="1.7976931348623157E308"
                      styleClass="announcement-grid" vgap="12.0" visible="false" managed="false"/>
        </VBox>
    </content>
</ScrollPane>
