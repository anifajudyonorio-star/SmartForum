<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.AnnouncementsController"
            prefWidth="900" prefHeight="600">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color:#2c3e50;-fx-padding:12;">
            <Label text="📢  Announcements" style="-fx-text-fill:white;-fx-font-size:22;-fx-font-weight:bold;"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.42">

            <!-- LEFT: Post announcement (lecturer) -->
            <VBox spacing="12" style="-fx-padding:20;">
                <Label text="Post Announcement" style="-fx-font-size:15;-fx-font-weight:bold;"/>

                <Label text="Target Category"/>
                <ComboBox fx:id="cmbCategory" maxWidth="Infinity"/>

                <Label text="Title"/>
                <TextField fx:id="txtTitle" promptText="Announcement title"/>

                <Label text="Message"/>
                <TextArea fx:id="txtMessage" promptText="Write your announcement…" prefRowCount="5" wrapText="true"/>

                <Label text="Posted by"/>
                <TextField fx:id="txtPostedBy" promptText="Your name / role"/>

                <Button text="Post Announcement" onAction="#postAnnouncement" maxWidth="Infinity"
                        style="-fx-background-color:#2980b9;-fx-text-fill:white;-fx-font-size:13;-fx-padding:9;"/>

                <Separator/>

                <!-- Student view filter -->
                <Label text="View as Student" style="-fx-font-size:14;-fx-font-weight:bold;"/>
                <Label text="Your Name"/>
                <TextField fx:id="txtStudentFilter" promptText="Enter student name to filter"/>
                <Button text="Load My Announcements" onAction="#loadStudentAnnouncements" maxWidth="Infinity"
                        style="-fx-background-color:#27ae60;-fx-text-fill:white;-fx-padding:8;"/>
            </VBox>

            <!-- RIGHT: Announcement list -->
            <VBox spacing="8" style="-fx-padding:16;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Announcements" style="-fx-font-size:15;-fx-font-weight:bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Show All" onAction="#loadAll" style="-fx-padding:5 12;"/>
                    <Button text="Delete Selected" onAction="#deleteSelected"
                            style="-fx-background-color:#e74c3c;-fx-text-fill:white;-fx-padding:5 12;"/>
                </HBox>

                <TableView fx:id="tblAnnouncements" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                        <TableColumn fx:id="colTitle"    text="Title"    prefWidth="160"/>
                        <TableColumn fx:id="colMessage"  text="Message"  prefWidth="260"/>
                        <TableColumn fx:id="colBy"       text="Posted By" prefWidth="110"/>
                        <TableColumn fx:id="colAt"       text="Date"      prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>
