<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.TakeQuizController"
            styleClass="quiz-page" stylesheets="@/com/smartforum/css/app.css">

    <content>
        <VBox spacing="12.0" styleClass="dashboard-content">
            <HBox alignment="TOP_LEFT" spacing="12.0" styleClass="dashboard-header">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Available Quizzes" styleClass="dashboard-title"/>
                    <Label text="Enroll in a quiz title, then take quizzes within their active window. Each quiz can only be taken once."
                           styleClass="dashboard-subtitle"/>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Button fx:id="btnAnnouncements" mnemonicParsing="false" onAction="#openAnnouncements"
                            styleClass="btn-outline btn-sm" text="Announcements"/>
                    <Button fx:id="btnQuizProgress" mnemonicParsing="false" onAction="#openQuizProgress"
                            styleClass="btn-outline btn-sm" text="My Quiz Progress"/>
                </HBox>
            </HBox>

            <Label fx:id="lblFeedback" managed="false" styleClass="quiz-recovery-notice" visible="false" wrapText="true"/>

            <VBox spacing="12.0" styleClass="dashboard-card">
                <Label text="Quiz Title Enrollment" styleClass="dashboard-card-title"/>
                <VBox fx:id="enrolledPane" managed="false" spacing="8.0" visible="false">
                    <Label fx:id="lblEnrolledInfo" wrapText="true"/>
                    <Button fx:id="btnUnenroll" mnemonicParsing="false" onAction="#unenroll"
                            styleClass="btn-danger btn-sm" text="Unenroll"/>
                </VBox>
                <VBox fx:id="enrollPane" spacing="8.0">
                    <Label styleClass="dashboard-subtitle"
                           text="You must enroll in one quiz title before you can take quizzes." wrapText="true"/>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Select quiz title" styleClass="form-label"/>
                            <ComboBox fx:id="cmbEnrollCategory" maxWidth="1.7976931348623157E308"
                                      promptText="Choose a quiz title"/>
                        </VBox>
                        <Button fx:id="btnEnroll" mnemonicParsing="false" onAction="#enroll"
                                prefWidth="140.0" styleClass="btn-primary" text="Enroll Me"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox spacing="8.0" styleClass="dashboard-card" VBox.vgrow="ALWAYS">
                <Label text="Available Quizzes" styleClass="dashboard-card-title"/>
                <TableView fx:id="tblAvailableQuizzes" styleClass="dashboard-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colQuiz" prefWidth="220.0" text="Quiz"/>
                        <TableColumn fx:id="colQuestions" prefWidth="90.0" text="Questions"/>
                        <TableColumn fx:id="colMaximumMarks" prefWidth="110.0" text="Maximum Marks"/>
                        <TableColumn fx:id="colScheduled" prefWidth="140.0" text="Scheduled"/>
                        <TableColumn fx:id="colDuration" prefWidth="90.0" text="Duration"/>
                        <TableColumn fx:id="colEndsAt" prefWidth="140.0" text="Ends At"/>
                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status"/>
                        <TableColumn fx:id="colAction" prefWidth="120.0" text="Action"/>
                    </columns>
                    <placeholder>
                        <Label fx:id="tblEmptyLabel" styleClass="empty-label"
                               text="Enroll in a quiz title to see available quizzes."/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
