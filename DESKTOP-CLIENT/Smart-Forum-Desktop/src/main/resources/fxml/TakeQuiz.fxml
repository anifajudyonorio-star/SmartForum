<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.TakeQuizController"
            style="-fx-background-color:#f8f9fa;">

    <!-- PAGE HEADER -->
    <top>
        <VBox style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:0 0 1 0;">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <VBox spacing="2">
                <Label text="Available Quizzes"
                       style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#212529;"/>
                <Label text="Take quizzes assigned to your category. Each quiz can only be taken once."
                       style="-fx-font-size:13;-fx-text-fill:#6c757d;"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <!-- STUDENT NAME + LOAD ROW -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:1;-fx-background-radius:6;-fx-border-radius:6;-fx-padding:14 20;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),4,0,0,1);">
                <Label text="Your Name:" style="-fx-font-size:13;-fx-font-weight:bold;"/>
                <TextField fx:id="txtStudentName" promptText="Enter your full name"
                           prefWidth="220"
                           style="-fx-font-size:13;-fx-padding:6 10;-fx-border-color:#ced4da;-fx-border-radius:4;-fx-background-radius:4;"/>
                <Button text="Load My Quizzes" onAction="#onNameEntered"
                        style="-fx-background-color:#0d6efd;-fx-text-fill:white;-fx-padding:6 16;-fx-background-radius:4;-fx-cursor:hand;"/>
                <Label fx:id="lblCategoryInfo" wrapText="true"
                       style="-fx-font-size:12;-fx-text-fill:#0d6efd;"/>
            </HBox>

            <!-- QUIZZES TABLE CARD -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:1;-fx-background-radius:6;-fx-border-radius:6;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                <TableView fx:id="tblAvailableQuizzes" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:transparent;-fx-border-color:transparent;">
                    <columns>
                        <TableColumn fx:id="colQTitle"     text="Quiz"           prefWidth="220"/>
                        <TableColumn fx:id="colQCategory"  text="Category"       prefWidth="160"/>
                        <TableColumn fx:id="colQQuestions" text="Questions"      prefWidth="90"/>
                        <TableColumn fx:id="colQDuration"  text="Duration"       prefWidth="90"/>
                        <TableColumn fx:id="colQStart"     text="Scheduled"      prefWidth="140"/>
                        <TableColumn fx:id="colQEnd"       text="Ends At"        prefWidth="140"/>
                        <TableColumn fx:id="colQStatus"    text="Status"         prefWidth="100"/>
                    </columns>
                    <placeholder><Label text="No quizzes available right now. Enter your name and click Load My Quizzes."
                                        style="-fx-text-fill:#6c757d;-fx-font-size:13;"/></placeholder>
                </TableView>
            </VBox>

            <!-- START QUIZ BUTTON ROW -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="▶  Start Quiz" onAction="#startQuiz"
                        style="-fx-background-color:#0d6efd;-fx-text-fill:white;-fx-font-size:14;-fx-padding:9 24;-fx-background-radius:5;-fx-cursor:hand;"/>
                <Label text="Select a quiz from the table above, then click Start Quiz."
                       style="-fx-font-size:12;-fx-text-fill:#6c757d;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
