<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.ResultsController"
            style="-fx-background-color:#f8f9fa;">

    <!-- PAGE HEADER -->
    <top>
        <VBox style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:0 0 1 0;">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Performance Report"
                           style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#212529;"/>
                    <Label text="Results for all students after quiz submission."
                           style="-fx-font-size:13;-fx-text-fill:#6c757d;"/>
                </VBox>
                <Button text="Refresh" onAction="#refreshResults"
                        style="-fx-background-color:#6c757d;-fx-text-fill:white;-fx-padding:7 16;-fx-background-radius:5;-fx-cursor:hand;"/>
                <Button text="Delete Selected" onAction="#deleteResult"
                        style="-fx-background-color:#dc3545;-fx-text-fill:white;-fx-padding:7 16;-fx-background-radius:5;-fx-cursor:hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:1;-fx-background-radius:6;-fx-border-radius:6;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                <TableView fx:id="tblResults" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:transparent;-fx-border-color:transparent;">
                    <columns>
                        <TableColumn fx:id="colStudent"      text="Student"        prefWidth="180"/>
                        <TableColumn fx:id="colQuiz"         text="Quiz"           prefWidth="200"/>
                        <TableColumn fx:id="colScore"        text="Score"          prefWidth="80"/>
                        <TableColumn fx:id="colTotalMarks"   text="Total Marks"    prefWidth="100"/>
                        <TableColumn fx:id="colPercentage"   text="Percentage"     prefWidth="100"/>
                        <TableColumn fx:id="colParticipation" text="Participation" prefWidth="110"/>
                        <TableColumn fx:id="colTotalScore"   text="Final Score"    prefWidth="100"/>
                        <TableColumn fx:id="colDate"         text="Date Taken"     prefWidth="160"/>
                        <TableColumn fx:id="colId"           text="ID"             prefWidth="50"/>
                    </columns>
                    <placeholder><Label text="No results found."
                                        style="-fx-text-fill:#6c757d;-fx-font-size:13;"/></placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
