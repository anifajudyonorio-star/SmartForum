<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.ResultsController"
            styleClass="quiz-page">

    <!-- PAGE HEADER -->
    <top>
        <VBox styleClass="dashboard-header">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Performance Report"
                           styleClass="dashboard-title"/>
                    <Label text="Track student outcomes and compare performance across previous quizzes."
                           styleClass="dashboard-subtitle"/>
                </VBox>
                <Label text="Quiz:" styleClass="form-label"/>
                <ComboBox fx:id="quizFilter" prefWidth="190"/>
                <Button text="Refresh" onAction="#refreshResults"
                        styleClass="btn-outline"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
        <content>
        <VBox spacing="16" styleClass="dashboard-content" minWidth="760">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" spacing="4"
                      styleClass="stat-card">
                    <Label text="SUBMISSIONS" styleClass="stat-label"/>
                    <Label fx:id="totalSubmissionsLabel" text="0" styleClass="stat-number"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" spacing="4"
                      styleClass="stat-card">
                    <Label text="STUDENTS ASSESSED" styleClass="stat-label"/>
                    <Label fx:id="studentsAssessedLabel" text="0" styleClass="stat-number"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" spacing="4"
                      styleClass="stat-card">
                    <Label text="AVERAGE SCORE" styleClass="stat-label"/>
                    <Label fx:id="averageScoreLabel" text="0.0%" styleClass="stat-number"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" spacing="4"
                      styleClass="stat-card">
                    <Label text="PASS RATE" styleClass="stat-label"/>
                    <Label fx:id="passRateLabel" text="0.0%" styleClass="stat-number"/>
                </VBox>
            </HBox>

            <HBox prefHeight="260" spacing="16">
                <VBox HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                      styleClass="dashboard-card stats-chart-card">
                    <BarChart fx:id="quizAverageChart" animated="false" legendVisible="false"
                              title="Average Score by Quiz" HBox.hgrow="ALWAYS" styleClass="stats-bar-chart">
                        <xAxis>
                            <CategoryAxis label="Quiz"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Average (%)" lowerBound="0" upperBound="100"
                                        tickUnit="20" autoRanging="false"/>
                        </yAxis>
                    </BarChart>
                </VBox>
                <VBox prefWidth="390" minWidth="340"
                      styleClass="dashboard-card stats-chart-card">
                    <PieChart fx:id="scoreDistributionChart" animated="false"
                              labelsVisible="true" legendVisible="false"
                              title="Score Distribution" styleClass="stats-pie-chart"/>
                </VBox>
            </HBox>

            <VBox styleClass="dashboard-card">
                <TableView fx:id="tblResults" prefHeight="320"
                           styleClass="dashboard-table">
                    <columns>
                        <TableColumn fx:id="colStudent"      text="Student"        prefWidth="180"/>
                        <TableColumn fx:id="colQuiz"         text="Quiz"           prefWidth="200"/>
                        <TableColumn fx:id="colScore"        text="Score"          prefWidth="80"/>
                        <TableColumn fx:id="colTotalMarks"   text="Total Marks"    prefWidth="100"/>
                        <TableColumn fx:id="colPercentage"   text="Percentage"     prefWidth="100"/>
                        <TableColumn fx:id="colParticipation" text="Participation" prefWidth="110"/>
                        <TableColumn fx:id="colTotalScore"   text="Final Score"    prefWidth="100"/>
                        <TableColumn fx:id="colDate"         text="Date Taken"     prefWidth="160"/>
                        <TableColumn fx:id="colId"           text="ID"             prefWidth="50"/>
                    </columns>
                    <placeholder><Label text="No results found."
                                        styleClass="empty-label"/></placeholder>
                </TableView>
            </VBox>

        </VBox>
        </content>
        </ScrollPane>
    </center>

</BorderPane>
