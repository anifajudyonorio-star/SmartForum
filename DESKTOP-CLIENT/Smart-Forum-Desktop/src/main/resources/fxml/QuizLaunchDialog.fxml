<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartforum.controller.QuizLaunchDialogController"
      spacing="14"
      styleClass="quiz-launch-dialog">
    <padding><Insets top="20" right="22" bottom="18" left="22"/></padding>

    <Label text="QUIZ TIME" styleClass="quiz-launch-eyebrow"/>
    <Label fx:id="lblTitle" wrapText="true" styleClass="dashboard-title"/>
    <Label fx:id="lblDescription" wrapText="true" styleClass="dashboard-subtitle"/>

    <VBox alignment="CENTER" spacing="4" styleClass="quiz-launch-timer-wrap">
        <Label fx:id="lblTimerLabel" text="Starts in" styleClass="stat-label"/>
        <Label fx:id="lblTimer" text="00:00" styleClass="quiz-launch-timer"/>
    </VBox>

    <HBox spacing="12">
        <Label fx:id="lblDuration" styleClass="quiz-badge"/>
        <Label fx:id="lblQuestions" styleClass="quiz-badge"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnLater" text="Later" onAction="#onLater" styleClass="btn-outline"/>
        <Button fx:id="btnStart" text="Start Quiz" onAction="#onStart" styleClass="btn-primary"/>
    </HBox>
</VBox>
