<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.QuizController"
            prefWidth="1100"
            prefHeight="700">

    <top>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>

            <children>
                <Label text="Quiz Management">
                    <font>
                        <Font size="26"/>
                    </font>
                </Label>
            </children>

        </HBox>
    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="15" left="20" right="20" bottom="15"/>
            </padding>

            <GridPane hgap="10" vgap="10">

                <columnConstraints>
                    <ColumnConstraints prefWidth="150"/>
                    <ColumnConstraints prefWidth="300"/>
                    <ColumnConstraints prefWidth="150"/>
                    <ColumnConstraints prefWidth="300"/>
                </columnConstraints>

                <children>

                    <Label text="Category"/>
                    <ComboBox fx:id="cmbCategory"
                              GridPane.columnIndex="1"/>

                    <Label text="Quiz Title"
                           GridPane.columnIndex="2"/>

                    <TextField fx:id="txtTitle"
                               GridPane.columnIndex="3"/>

                    <Label text="Description"
                           GridPane.rowIndex="1"/>

                    <TextArea fx:id="txtDescription"
                              prefRowCount="3"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"/>

                    <Label text="Duration (Minutes)"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="2"/>

                    <Spinner fx:id="spDuration"
                             GridPane.rowIndex="1"
                             GridPane.columnIndex="3"/>

                    <Label text="Total Marks"
                           GridPane.rowIndex="2"/>

                    <Spinner fx:id="spMarks"
                             GridPane.rowIndex="2"
                             GridPane.columnIndex="1"/>

                    <Label text="Start Date"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="2"/>

                    <DatePicker fx:id="dpStart"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="3"/>

                    <Label text="End Date"
                           GridPane.rowIndex="3"/>

                    <DatePicker fx:id="dpEnd"
                                GridPane.rowIndex="3"
                                GridPane.columnIndex="1"/>

                </children>

            </GridPane>

            <HBox spacing="10">

                <Button fx:id="btnSave"
                        text="Save"
                        onAction="#saveQuiz"/>

                <Button fx:id="btnUpdate"
                        text="Update"
                        onAction="#updateQuiz"/>

                <Button fx:id="btnDelete"
                        text="Delete"
                        onAction="#deleteQuiz"/>

                <Button fx:id="btnClear"
                        text="Clear"
                        onAction="#clearFields"/>

            </HBox>

            <TableView fx:id="tblQuizzes" VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="colCategory"
                                 text="Category"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colTitle"
                                 text="Quiz Title"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colDuration"
                                 text="Duration"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colMarks"
                                 text="Marks"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colStart"
                                 text="Start Date"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colEnd"
                                 text="End Date"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>
