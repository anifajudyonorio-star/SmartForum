<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.QuizController"
            styleClass="quiz-page" stylesheets="@/com/smartforum/css/app.css">

    <content>
        <VBox spacing="12.0" styleClass="dashboard-content">
            <HBox alignment="TOP_LEFT" spacing="12.0" styleClass="dashboard-header">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Manage Quizzes" styleClass="dashboard-title"/>
                    <Label text="Create quiz titles, quizzes, and questions. Publish when ready."
                           styleClass="dashboard-subtitle"/>
                </VBox>
                <Label fx:id="quizCountLabel" styleClass="badge-muted" text="0"/>
            </HBox>

            <VBox spacing="8.0" styleClass="dashboard-card" VBox.vgrow="ALWAYS">
                <TableView fx:id="tblQuizzes" styleClass="dashboard-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitle" prefWidth="160.0" text="Quiz Title"/>
                        <TableColumn fx:id="colCategory" prefWidth="150.0" text="Quiz Title Template"/>
                        <TableColumn fx:id="colGroup" prefWidth="130.0" text="Group"/>
                        <TableColumn fx:id="colQuestions" prefWidth="90.0" text="Questions"/>
                        <TableColumn fx:id="colMaximumMarks" prefWidth="110.0" text="Maximum Marks"/>
                        <TableColumn fx:id="colDuration" prefWidth="90.0" text="Duration"/>
                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status"/>
                        <TableColumn fx:id="colActions" prefWidth="220.0" text="Actions"/>
                    </columns>
                    <placeholder>
                        <Label styleClass="empty-label" text="No quizzes yet."/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
