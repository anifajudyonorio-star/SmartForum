<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.QuizCategoryController"
            prefHeight="600.0"
            prefWidth="900.0">

    <top>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="15" bottom="15"/>
            </padding>

            <children>
                <Label text="Quiz Categories">
                    <font>
                        <Font size="24"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <children>

                <GridPane hgap="10" vgap="10">

                    <columnConstraints>
                        <ColumnConstraints prefWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <children>

                        <Label text="Category Name:"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="txtCategoryName"
                                   promptText="Enter category name"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"/>

                        <Label text="Description:"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <TextArea fx:id="txtDescription"
                                  promptText="Enter description"
                                  prefRowCount="3"
                                  GridPane.rowIndex="1"
                                  GridPane.columnIndex="1"/>

                    </children>

                </GridPane>

                <HBox spacing="10">

                    <children>

                        <Button fx:id="btnSave"
                                text="Save"
                                onAction="#saveCategory"/>

                        <Button fx:id="btnUpdate"
                                text="Update"
                                onAction="#updateCategory"/>

                        <Button fx:id="btnDelete"
                                text="Delete"
                                onAction="#deleteCategory"/>

                        <Button fx:id="btnClear"
                                text="Clear"
                                onAction="#clearFields"/>

                    </children>

                </HBox>

                <TableView fx:id="tblCategories" prefHeight="350">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="70"/>

                        <TableColumn fx:id="colCategory"
                                     text="Category Name"
                                     prefWidth="220"/>

                        <TableColumn fx:id="colDescription"
                                     text="Description"
                                     prefWidth="350"/>

                        <TableColumn fx:id="colCreatedBy"
                                     text="Created By"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </children>

        </VBox>
    </center>

</BorderPane>
