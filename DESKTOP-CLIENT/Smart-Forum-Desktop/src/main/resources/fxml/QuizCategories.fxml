<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartforum.controller.QuizCategoryController"
            style="-fx-background-color:#f8f9fa;">

    <!-- PAGE HEADER -->
    <top>
        <VBox style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:0 0 1 0;">
            <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Quiz Titles" style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#212529;"/>
                    <Label text="Manage quiz title templates used when creating quizzes."
                           style="-fx-font-size:13;-fx-text-fill:#6c757d;"/>
                </VBox>
                <Button fx:id="btnAdd" text="+ Add Quiz Title" onAction="#saveCategory"
                        style="-fx-background-color:#0d6efd;-fx-text-fill:white;-fx-font-size:13;-fx-padding:7 16;-fx-background-radius:5;-fx-cursor:hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <!-- FORM CARD -->
            <VBox style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:1;-fx-background-radius:6;-fx-border-radius:6;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                <VBox spacing="10">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Quiz Title" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#212529;"/>
                            <TextField fx:id="txtCategoryName" promptText="Enter quiz title name"
                                       style="-fx-font-size:13;-fx-padding:7 10;-fx-border-color:#ced4da;-fx-border-radius:4;-fx-background-radius:4;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Description" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#212529;"/>
                            <TextArea fx:id="txtDescription" promptText="Enter description (optional)"
                                      prefRowCount="2" wrapText="true"
                                      style="-fx-font-size:13;-fx-border-color:#ced4da;-fx-border-radius:4;-fx-background-radius:4;"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="8">
                        <Button text="Save" onAction="#saveCategory"
                                style="-fx-background-color:#0d6efd;-fx-text-fill:white;-fx-padding:6 16;-fx-background-radius:4;-fx-cursor:hand;"/>
                        <Button text="Update" onAction="#updateCategory"
                                style="-fx-background-color:#ffc107;-fx-text-fill:#212529;-fx-padding:6 16;-fx-background-radius:4;-fx-cursor:hand;"/>
                        <Button text="Delete" onAction="#deleteCategory"
                                style="-fx-background-color:#dc3545;-fx-text-fill:white;-fx-padding:6 16;-fx-background-radius:4;-fx-cursor:hand;"/>
                        <Button text="Clear" onAction="#clearFields"
                                style="-fx-background-color:#6c757d;-fx-text-fill:white;-fx-padding:6 16;-fx-background-radius:4;-fx-cursor:hand;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- TABLE CARD -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color:white;-fx-border-color:#dee2e6;-fx-border-width:1;-fx-background-radius:6;-fx-border-radius:6;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),6,0,0,2);">
                <TableView fx:id="tblCategories" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:transparent;-fx-border-color:transparent;">
                    <columns>
                        <TableColumn fx:id="colCategory"    text="Quiz Title"   prefWidth="260"/>
                        <TableColumn fx:id="colDescription" text="Description"  prefWidth="400"/>
                        <TableColumn fx:id="colCreatedBy"   text="Created By"   prefWidth="160"/>
                        <TableColumn fx:id="colId"          text="ID"           prefWidth="60"/>
                    </columns>
                    <placeholder><Label text="No quiz titles yet. Create one to start building quizzes."
                                        style="-fx-text-fill:#6c757d;-fx-font-size:13;"/></placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
