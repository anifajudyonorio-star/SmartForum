<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.smartforum.AuthController"
           style="-fx-background-color: #0a0f1e;">

    <VBox alignment="CENTER" maxWidth="400"
          style="-fx-background-color: #111827; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 4);">

        <!-- Brand Header -->
        <VBox alignment="CENTER" style="-fx-background-color: #166534; -fx-background-radius: 12 12 0 0; -fx-padding: 20 0 16 0;">
            <Label text="SD" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 8; -fx-padding: 8 12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
            <Label text="Smart Discussion" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 8 0 2 0;"/>
            <Label text="Sign in to continue" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12;"/>
        </VBox>

        <!-- Tabs -->
        <HBox style="-fx-padding: 12 16 0 16; -fx-spacing: 6;">
            <Button fx:id="signInTab" text="Sign In" onAction="#showSignIn"
                    maxWidth="Infinity" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 12; -fx-cursor: hand;">
                <HBox.hgrow>ALWAYS</HBox.hgrow>
            </Button>
            <Button fx:id="registerTab" text="Register" onAction="#showRegister"
                    maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 12; -fx-cursor: hand; -fx-border-color: #374151; -fx-border-radius: 6;">
                <HBox.hgrow>ALWAYS</HBox.hgrow>
            </Button>
        </HBox>

        <!-- Error Label -->
        <Label fx:id="errorLabel" text="" wrapText="true"
               style="-fx-text-fill: #f87171; -fx-font-size: 11; -fx-padding: 4 16 0 16;" maxWidth="400"/>

        <!-- Sign In Form -->
        <VBox fx:id="signInPane" style="-fx-padding: 8 16 0 16; -fx-spacing: 8;">
            <VBox spacing="4">
                <Label text="Email" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <TextField fx:id="loginEmail" promptText="Enter your email"
                           style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 10;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Password" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <StackPane>
                    <PasswordField fx:id="loginPassword" promptText="Enter your password"
                                   style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 36 8 10;"/>
                    <TextField fx:id="loginPasswordVisible" promptText="Enter your password" visible="false" managed="false"
                               style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 36 8 10;"/>
                    <Button fx:id="loginEyeBtn" text="👁" onAction="#toggleLoginPassword"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand; -fx-font-size: 13; -fx-padding: 0 8 0 0;"
                            StackPane.alignment="CENTER_RIGHT"/>
                </StackPane>
            </VBox>
            <Button text="Sign In" onAction="#handleSignIn" maxWidth="Infinity"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-cursor: hand; -fx-font-size: 13;"/>
            <Hyperlink text="Forgot password?" onAction="#handleForgotPassword"
                       style="-fx-text-fill: #6366f1; -fx-font-size: 11; -fx-border-color: transparent;" alignment="CENTER_RIGHT"/>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="8" style="-fx-padding: 2 0;">
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #374151;"/>
                <Label text="or" style="-fx-text-fill: #6b7280; -fx-font-size: 11;"/>
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #374151;"/>
            </HBox>

            <!-- Google Sign In -->
            <Button fx:id="googleSignInBtn" onAction="#handleGoogleSignIn" maxWidth="Infinity"
                    style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-cursor: hand; -fx-font-size: 12; -fx-border-color: #374151; -fx-border-radius: 6;"/>
        </VBox>

        <!-- Register Form -->
        <VBox fx:id="registerPane" visible="false" managed="false" style="-fx-padding: 8 16 0 16; -fx-spacing: 7;">
            <HBox spacing="8">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="First Name" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="regFname" promptText="First name"
                               style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 10;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Last Name" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
                    <TextField fx:id="regLname" promptText="Last name"
                               style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 10;"/>
                </VBox>
            </HBox>
            <VBox spacing="4">
                <Label text="Email" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <TextField fx:id="regEmail" promptText="Enter your email"
                           style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 10;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Password" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <StackPane>
                    <PasswordField fx:id="regPassword" promptText="Password"
                                   style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 36 8 10;"/>
                    <TextField fx:id="regPasswordVisible" promptText="Password" visible="false" managed="false"
                               style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 36 8 10;"/>
                    <Button fx:id="regEyeBtn" text="👁" onAction="#toggleRegPassword"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand; -fx-font-size: 13; -fx-padding: 0 8 0 0;"
                            StackPane.alignment="CENTER_RIGHT"/>
                </StackPane>
            </VBox>
            <VBox spacing="4">
                <Label text="Confirm Password" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: bold;"/>
                <StackPane>
                    <PasswordField fx:id="regPasswordConfirm" promptText="Confirm password"
                                   style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 36 8 10;"/>
                    <TextField fx:id="regPasswordConfirmVisible" promptText="Confirm password" visible="false" managed="false"
                               style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 6; -fx-border-color: #374151; -fx-border-radius: 6; -fx-padding: 8 36 8 10;"/>
                    <Button fx:id="regConfirmEyeBtn" text="👁" onAction="#toggleRegConfirmPassword"
                            style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand; -fx-font-size: 13; -fx-padding: 0 8 0 0;"
                            StackPane.alignment="CENTER_RIGHT"/>
                </StackPane>
            </VBox>
            <CheckBox fx:id="termsCheck" text="I agree to the Terms &amp; Conditions"
                      style="-fx-text-fill: #9ca3af; -fx-font-size: 11;"/>
            <Button text="Create Account" onAction="#handleRegister" maxWidth="Infinity"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-cursor: hand; -fx-font-size: 13;"/>

            <!-- Divider -->
            <HBox alignment="CENTER" spacing="8" style="-fx-padding: 2 0;">
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #374151;"/>
                <Label text="or" style="-fx-text-fill: #6b7280; -fx-font-size: 11;"/>
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: #374151;"/>
            </HBox>

            <!-- Google Register -->
            <Button fx:id="googleRegisterBtn" onAction="#handleGoogleSignIn" maxWidth="Infinity"
                    style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10; -fx-cursor: hand; -fx-font-size: 12; -fx-border-color: #374151; -fx-border-radius: 6;"/>
        </VBox>

        <VBox.margin>
            <Insets bottom="16"/>
        </VBox.margin>

    </VBox>
</StackPane>
