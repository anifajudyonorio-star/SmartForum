<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartforum.StudentDashboardController"
            prefWidth="860" prefHeight="580"
            style="-fx-background-color: #0a0f1e;">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="220" style="-fx-background-color: #111827; -fx-border-color: #1f2937; -fx-border-width: 0 1 0 0;">

            <!-- Brand -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #166534; -fx-padding: 16 14;">
                <Label text="SD" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 6; -fx-padding: 4 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12;"/>
                <Label text="Smart Discussion" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
            </HBox>

            <!-- User info -->
            <VBox style="-fx-padding: 14 14 10 14; -fx-border-color: #1f2937; -fx-border-width: 0 0 1 0;" spacing="2">
                <Label fx:id="userNameLabel" text="" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
                <Label fx:id="userRoleLabel" text="" style="-fx-text-fill: #4ade80; -fx-font-size: 11;"/>
            </VBox>

            <!-- Groups label -->
            <Label text="MY GROUPS" style="-fx-text-fill: #6b7280; -fx-font-size: 10; -fx-font-weight: bold; -fx-padding: 12 14 4 14;"/>

            <!-- Groups list -->
            <ListView fx:id="groupsListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #d1d5db;"/>

            <!-- Logout -->
            <Button text="⏻  Logout" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-font-size: 12; -fx-cursor: hand; -fx-padding: 10 14; -fx-border-color: #1f2937; -fx-border-width: 1 0 0 0; -fx-alignment: CENTER_LEFT;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox style="-fx-background-color: #0d1117; -fx-padding: 24;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
                <Label text="Topics" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Double-click a topic to open chat"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11;"/>
            </HBox>

            <!-- Topics list -->
            <StackPane VBox.vgrow="ALWAYS">
                <ListView fx:id="topicsListView"
                          style="-fx-background-color: #111827; -fx-background-radius: 8; -fx-border-color: #1f2937; -fx-border-radius: 8;"/>
                <Label fx:id="topicsPlaceholder" text="Select a group to see its topics."
                       visible="true"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 13;"/>
            </StackPane>

        </VBox>
    </center>

</BorderPane>
