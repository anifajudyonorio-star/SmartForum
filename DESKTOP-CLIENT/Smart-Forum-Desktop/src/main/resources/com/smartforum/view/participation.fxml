<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartforum.controller.ParticipationViewController">
   <content>
      <VBox spacing="12.0" styleClass="dashboard-content">
         <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="dashboard-header">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <Label styleClass="dashboard-title" text="🏆 Participation Leaderboard" />
               <Label fx:id="headerSubtitleLabel" styleClass="dashboard-subtitle" text="Track student engagement across topics, posts, and replies." />
            </VBox>
            <Label fx:id="topParticipantLabel" styleClass="badge-primary" text="" />
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label styleClass="form-label" text="Filter by group:" />
            <ComboBox fx:id="groupFilterCombo" prefWidth="220.0" />
         </HBox>

         <VBox fx:id="criteriaBox" managed="false" spacing="0.0" styleClass="dashboard-card" visible="false">
            <HBox styleClass="dashboard-card-header">
               <Label styleClass="dashboard-card-title" text="Grading criteria" />
            </HBox>
            <GridPane fx:id="criteriaGrid" hgap="10.0" styleClass="dashboard-card-body" vgap="10.0" />
         </VBox>

         <FlowPane fx:id="participantsBox" hgap="12.0" maxWidth="1.7976931348623157E308" styleClass="participation-grid" vgap="12.0" />
      </VBox>
   </content>
</ScrollPane>
