<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartforum.controller.UserManagementController">
   <content>
      <VBox spacing="12.0" styleClass="dashboard-content">
         <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="dashboard-header">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <Label styleClass="dashboard-title" text="User Management" />
               <Label styleClass="dashboard-subtitle" text="Issue warnings, manage roles, and review blacklisted users." />
            </VBox>
            <Button mnemonicParsing="false" onAction="#showAddLecturerDialog" styleClass="btn-primary" text="Add Lecturer" />
         </HBox>

         <VBox spacing="0.0" styleClass="dashboard-card" VBox.vgrow="ALWAYS">
            <HBox styleClass="dashboard-card-header">
               <Label styleClass="dashboard-card-title" text="All Users" />
               <HBox HBox.hgrow="ALWAYS" />
               <Label fx:id="userCountLabel" styleClass="badge-muted" text="0" />
            </HBox>
            <TableView fx:id="usersTable" styleClass="dashboard-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colName" prefWidth="140.0" text="Name" />
                  <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                  <TableColumn fx:id="colRole" prefWidth="90.0" text="Role" />
                  <TableColumn fx:id="colWarnings" prefWidth="80.0" text="Warnings" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colActions" prefWidth="220.0" text="Actions" />
               </columns>
               <placeholder>
                  <Label styleClass="empty-label" text="No users found." />
               </placeholder>
            </TableView>
         </VBox>
      </VBox>
   </content>
</ScrollPane>
